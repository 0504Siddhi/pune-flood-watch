# Pune Flood Watch - Environment Configuration Template
# NOTE: The current release is fully functional client-side without any environment variables.
# This template is provided for developers testing future serverless or external tile integrations.

# Optional AWS API Gateway Endpoint (for future Lambda / DynamoDB backend)
VITE_AWS_API_GATEWAY_URL=

# Map Tile Server URL (defaults to OpenStreetMap public tiles if omitted)
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Feature flag for future automated weather ingestion
VITE_ENABLE_LIVE_WEATHER_FEED=false

